{
    "tasks": {
        "dev": "deno run --watch --allow-net --allow-env --allow-read main.ts"
    },
    "imports": {
        "@hono/hono": "jsr:@hono/hono@^4.7.4",
        "@std/assert": "jsr:@std/assert@1",
        "ioredis": "npm:ioredis@^5.6.0"
    },
    "fmt": {
        "options": {
            "useTabs": false,
            "lineWidth": 120,
            "indentWidth": 2,
            "singleQuote": false,
            "proseWrap": "preserve",
            "importOrder": [
                "^(https?://|file:)",
                "^@std/",
                "^std/",
                "^[^.]",
                "^[./]"
            ],
            "importOrderSeparation": true,
            "importOrderSortSpecifiers": true,
            "importOrderParserPlugins": [
                "typescript",
                "jsx",
                "decorators-legacy"
            ],
            "emptyLineBeforeReturn": false,
            "semiColons": true,
            "lineEnding": "lf",
            "newLineAtEnd": true
        },
        "lineEnding": "lf",
        "indentStyle": "space",
        "indentWidth": 4,
        "exclude": [
            "**/node_modules/",
            "**/.git/"
        ],
        "singleQuote": false
    },
    "lint": {
        "rules": {
            "tags": [
                "recommended"
            ],
            "exclude": [
                "no-explicit-any"
            ],
            "include": [
                "eqeqeq",
                "no-const-assign"
            ]
        }
    },
    "nodeModulesDir": "auto",
    "lock": "./deno.lock"
}
